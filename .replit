modules = ["nodejs-20", "python-3.12"]
# The Run button starts the operator console (port 5000, shown in the Preview pane) and the
# mock credit-union app it drives (port 5001). See scripts/dev.sh.
run = "bash scripts/dev.sh"

[env]
# Keep Claude Code config and session history on the persistent workspace disk (gitignored).
CLAUDE_CONFIG_DIR = "/home/runner/workspace/.claude-user"

[nix]
packages = ["gitFull", "nano", "playwright-driver"]

[[ports]]
localPort = 5000
externalPort = 80
